# ==========================
# Application Configuration
# ==========================

APP_NAME=Certificate Lifecycle Automation Platform
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# ==========================
# API
# ==========================

HOST=127.0.0.1
PORT=8000

# ==========================
# Database
# ==========================

DATABASE_URL=postgresql://postgres:password@localhost:5432/certificate_platform

# ==========================
# Security
# ==========================

SECRET_KEY=change_this_to_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================
# Logging
# ==========================

LOG_LEVEL=INFO